  "components": {
    "schemas": {
      "ActionType": {
        "type": "string",
        "enum": [
          "CANCEL_ORDER",
          "RETURN_ITEM",
          "EXCHANGE_ITEM"
        ],
        "title": "ActionType"
      },
      "ApprovalStatus": {
        "type": "string",
        "enum": [
          "PREPARED",
          "PRESENTED",
          "CONFIRMED",
          "EXECUTING",
          "EXECUTED",
          "EXPIRED",
          "SUPERSEDED",
          "CANCELLED",
          "FAILED"
        ],
        "title": "ApprovalStatus"
      },
      "AuthRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "verification_code": {
            "type": "string",
            "maxLength": 12,
            "minLength": 4,
            "title": "Verification Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "verification_code"
        ],
        "title": "AuthRequest"
      },
      "AuthResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "access_token",
          "customer_id",
          "expires_at"
        ],
        "title": "AuthResponse"
      },
      "ConfirmActionRequest": {
        "properties": {
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Preview Hash"
          },
          "ui_event_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 8,
            "title": "Ui Event Id"
          },
          "confirmation_source": {
            "$ref": "#/components/schemas/ConfirmationSource"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "preview_hash",
          "ui_event_id",
          "confirmation_source"
        ],
        "title": "ConfirmActionRequest"
      },
      "ConfirmationSource": {
        "type": "string",
        "enum": [
          "BUTTON",
          "EXACT_TEXT"
        ],
        "title": "ConfirmationSource"
      },
      "EligibilityReason": {
        "type": "string",
        "enum": [
          "ELIGIBLE",
          "ORDER_NOT_FOUND",
          "ORDER_NOT_OWNED",
          "ITEM_NOT_FOUND",
          "ORDER_ALREADY_CANCELLED",
          "ORDER_ALREADY_SHIPPED",
          "ORDER_NOT_DELIVERED",
          "RETURN_WINDOW_EXPIRED",
          "FINAL_SALE",
          "ITEM_CONDITION_NOT_ALLOWED",
          "TARGET_SIZE_REQUIRED",
          "TARGET_SIZE_UNCHANGED",
          "OUT_OF_STOCK",
          "ACTIVE_REQUEST_EXISTS",
          "HUMAN_REVIEW_REQUIRED",
          "INVALID_ACTION"
        ],
        "title": "EligibilityReason"
      },
      "EligibilityRequest": {
        "properties": {
          "action_type": {
            "$ref": "#/components/schemas/ActionType"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "order_item_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Item Id"
          },
          "target_size": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Size"
          },
          "declared_condition": {
            "$ref": "#/components/schemas/ItemCondition",
            "default": "NEW_UNWORN"
          },
          "issue_type": {
            "$ref": "#/components/schemas/IssueType",
            "default": "CHANGED_MIND"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action_type",
          "order_id"
        ],
        "title": "EligibilityRequest"
      },
      "EligibilityResponse": {
        "properties": {
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "reason_code": {
            "$ref": "#/components/schemas/EligibilityReason"
          },
          "user_message": {
            "type": "string",
            "title": "User Message"
          },
          "available_alternative": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Alternative"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "allowed",
          "reason_code",
          "user_message"
        ],
        "title": "EligibilityResponse"
      },
      "ExecuteActionResponse": {
        "properties": {
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "approval_id": {
            "type": "string",
            "title": "Approval Id"
          },
          "action_type": {
            "$ref": "#/components/schemas/ActionType"
          },
          "idempotent_replay": {
            "type": "boolean",
            "title": "Idempotent Replay",
            "default": false
          },
          "result": {
            "additionalProperties": true,
            "type": "object",
            "title": "Result"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "execution_id",
          "approval_id",
          "action_type",
          "result"
        ],
        "title": "ExecuteActionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InventoryRead": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "size": {
            "type": "string",
            "title": "Size"
          },
          "available_qty": {
            "type": "integer",
            "title": "Available Qty"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku",
          "size",
          "available_qty",
          "updated_at"
        ],
        "title": "InventoryRead"
      },
      "IssueType": {
        "type": "string",
        "enum": [
          "CHANGED_MIND",
          "SIZE_MISMATCH",
          "WRONG_ITEM",
          "DEFECTIVE",
          "DAMAGED_IN_TRANSIT"
        ],
        "title": "IssueType"
      },
      "ItemCondition": {
        "type": "string",
        "enum": [
          "NEW_UNWORN",
          "OPENED_UNUSED",
          "USED",
          "DAMAGED"
        ],
        "title": "ItemCondition"
      },
      "OrderItemRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
