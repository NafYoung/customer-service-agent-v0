DATABASE_URL=sqlite:///./customer_service.db
AUTH_SESSION_MINUTES=60
APPROVAL_TTL_MINUTES=10
DEMO_VERIFICATION_CODE=246810
HOST_CONFIRMATION_TOKEN=
ENABLE_DEBUG_ROUTES=false
DEBUG_ADMIN_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_MAX_RETRIES=2
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_TOOL_CALLS=12
APP_MODE=local
DEMO_AGENT_MODE=preparation_scripted
DEMO_ALLOWED_ORIGIN=http://127.0.0.1:8000
# On Render, leave DEMO_ALLOWED_ORIGIN unset to use RENDER_EXTERNAL_URL.
# public_demo allows: preparation_scripted | offline_replay (never live DeepSeek).
# local live (budget-gated DeepSeek; never deploy publicly):
#   APP_MODE=local DEMO_AGENT_MODE=preparation_live DEEPSEEK_API_KEY=... HOST_CONFIRMATION_TOKEN=...
DEMO_COOKIE_SECURE=true
DEMO_SESSION_TTL_MINUTES=30
DEMO_MAX_ACTIVE_SESSIONS=50
DEMO_MAX_MESSAGES_PER_SESSION=30
DEMO_MAX_PREPARE_PER_SESSION=3
DEMO_MAX_CONFIRM_PER_SESSION=3
DEMO_MAX_LIVE_ATTEMPTS_PER_SESSION=8
# 模型路由预留：留空回退 DEEPSEEK_MODEL；换模型前必须先提供其价格快照。
DEMO_LIVE_QUERY_MODEL=
DEMO_LIVE_ACTION_MODEL=
